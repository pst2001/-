<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        安全说明（重要）：
        本应用刻意不声明任何 <uses-permission>。
          · 不需要 INTERNET —— 全部朗读由系统内置 TextToSpeech 引擎在本机完成；
          · 不需要 RECORD_AUDIO —— 只做「文字 → 语音」，从不采集麦克风；
          · 不需要存储权限 —— 不读写任何外部文件，也不导出音频；
          · 不需要 READ_PHONE_STATE 等设备信息权限 —— 音频焦点由 AudioManager 自动回调。
    -->

    <!-- Android 11+ 的包可见性：允许系统查找 TTS 引擎服务（否则部分机型会拿不到引擎） -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TtsApp"
        android:usesCleartextTraffic="false">

        <!--
            整个 App 只有这一个组件，且它是桌面启动入口，必须 exported=true。
            没有 Service / Receiver / Provider，也没有任何对外 Intent 过滤器，
            外部应用无法通过组件调用把文本塞进来（避免被当作「朗读器」滥用）。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TtsApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
